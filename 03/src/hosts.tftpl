[all:vars]
ansible_user=guskov-ka
ansible_ssh_private_key_file=/home/davlanas/.ssh/k.guskov

[webservers]
%{~ for i in webservers ~}

${i["name"]}            ansible_host=${i["network_interface"][0]["nat_ip_address"] != "" ? i["network_interface"][0]["nat_ip_address"] : i["network_interface"][0]["ip_address"]} fqdn=${i["fqdn"]}
%{~ endfor ~}


[databases]
%{~ for i in databases ~}

${i["name"]}            ansible_host=${i["network_interface"][0]["nat_ip_address"] != "" ? i["network_interface"][0]["nat_ip_address"] : i["network_interface"][0]["ip_address"]} fqdn=${i["fqdn"]}
%{~ endfor ~}


[storages]
%{~ for i in storage ~}

${i["name"]}            ansible_host=${i["network_interface"][0]["nat_ip_address"] != "" ? i["network_interface"][0]["nat_ip_address"] : i["network_interface"][0]["ip_address"]} fqdn=${i["fqdn"]}
%{~ endfor ~}